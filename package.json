{
  "name": "sharesecure",
  "version": "1.27.1",
  "description": "Private, encrypted file sharing — self-hosted edition",
  "main": "desktop/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/launcher.js",
    "test": "node --test tests/*.test.cjs",
    "verify-site": "node scripts/verify-site.mjs",
    "desktop": "electron-builder install-app-deps && electron .",
    "postdesktop": "npm run sqlite-for-node",
    "dist": "electron-builder --publish never",
    "postdist": "npm run sqlite-for-node",
    "sqlite-for-node": "npm rebuild better-sqlite3 && node -e \"require('fs').rmSync('node_modules/better-sqlite3/build/Release/.forge-meta', { force: true })\"",
    "generate-key": "node -e \"console.log('ENCRYPTION_KEY=' + require('crypto').randomBytes(32).toString('hex'))\"",
    "icons": "electron desktop/update-icons.js",
    "token-key": "node -e \"console.log('TOKEN_ISSUER_KEY=' + require('crypto').generateKeyPairSync('rsa', { modulusLength: 2048 }).privateKey.export({ type: 'pkcs8', format: 'der' }).toString('base64'))\"",
    "rosette": "node desktop/rosette.js"
  },
  "keywords": [],
  "author": "Ishaan",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "multer": "^2.1.1"
  },
  "optionalDependencies": {
    "heic-convert": "^2.1.0"
  },
  "devDependencies": {
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ishaanman7898/ShareSecure.git"
  },
  "build": {
    "appId": "app.sharesecure.desktop",
    "productName": "ShareSecure",
    "directories": {
      "output": "dist",
      "buildResources": "desktop"
    },
    "icon": "desktop/icon.png",
    "files": [
      "desktop/**",
      "server/**",
      "public/**",
      ".env.example",
      "package.json",
      "!**/*.map",
      "!desktop/update-icons.js",
      "!desktop/icon-source.png",
      "!desktop/rosette.js",
      "!desktop/plugin-icon.py",
      "!desktop/entitlements.mac.plist",
      "!**/node_modules/better-sqlite3/{bin,deps,src}/**",
      "!**/node_modules/better-sqlite3/build/deps/**",
      "!**/node_modules/better-sqlite3/build/Release/{obj,.deps}/**",
      "!**/node_modules/better-sqlite3/build/Release/*.{pdb,iobj,ipdb,lib,exp,ilk,a}",
      "!**/node_modules/better-sqlite3/build/Release/test_extension*",
      "!**/node_modules/better-sqlite3/build/*.{sln,vcxproj,vcxproj.filters,mk,gypi}",
      "!**/node_modules/better-sqlite3/build/{Makefile,config.gypi}",
      "!**/node_modules/better-sqlite3/binding.gyp",
      "!**/node_modules/libheif-js/libheif/**",
      "!**/node_modules/libheif-js/libheif-wasm/{libheif.js,libheif.wasm,libheif-bundle.mjs,libheif.d.ts}"
    ],
    "electronLanguages": [
      "en",
      "en-US",
      "en-GB",
      "en_GB"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "afterPack": "scripts/mac-licenses.cjs",
    "publish": {
      "provider": "github",
      "owner": "ishaanman7898",
      "repo": "ShareSecure"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "ShareSecure-Setup.${ext}",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShareSecure"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "ShareSecure-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "ShareSecure-linux.${ext}"
    }
  }
}
